---
interface Props {
  period: string;
  company: string;
  role?: string;
  tech?: string;
  bullets: string[];
}

const { period, company, role, tech, bullets } = Astro.props;

const periodParts = period.split(" - ");
const start = periodParts[0] || "";
const end = periodParts[1] || "";
const isCurrent = end.toUpperCase() === "PRESENT";
---

<article class="flex gap-3 py-2 avoid-break print:break-inside-avoid border-b border-slate-100 last:border-b-0">
  <div class="w-20 shrink-0 text-[11px] text-slate-500 font-medium pt-0.5 leading-tight text-center">
    <div>{start}</div>
    <div class="text-slate-400">—</div>
    <div class={isCurrent ? "text-accent font-semibold" : ""}>{end}</div>
  </div>
  <div class="flex-1 space-y-1">
    <div class="flex flex-col">
      <h3 class="font-bold text-slate-900 text-sm">{company}</h3>
      {role && <div class="text-xs font-medium text-slate-600">{role}</div>}
    </div>
    {
      tech && (
        <div class="text-[10px] text-slate-500">{tech}</div>
      )
    }
    <ul class="space-y-1 text-xs text-slate-600 leading-snug">
      {bullets.map((b) => (
        <li class="flex items-start gap-1.5 avoid-break">
          <span class="text-accent mt-0.5">•</span>
          <span>{b}</span>
        </li>
      ))}
    </ul>
  </div>
</article>
