---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile, sidebarSections, work } from "../config/config";

const techStack =
  sidebarSections.find((s) => s.title === "Technologies")?.items ?? [];
const softSkills =
  sidebarSections.find((s) => s.title === "Soft skills")?.items ?? [];
const languages =
  sidebarSections.find((s) => s.title === "Languages")?.items ?? [];

// Featured/recent experiences
const featuredWork = work.slice(0, 4);
---

<BaseLayout title={`${profile.name} - Portfolio`}>
  <!-- Header -->
  <header class="glass-strong border-b border-slate-200/60 sticky top-0 z-50">
    <div class="mx-auto max-w-7xl px-6 py-3 flex items-center justify-between">
      <a href="/" class="font-heading font-bold text-lg text-gradient">
        WB
      </a>
      <nav class="flex items-center gap-2">
        <a
          href="#experience"
          class="px-3 py-1.5 text-sm font-medium text-slate-600 hover:text-accent transition-colors rounded-lg hover:bg-slate-100"
        >
          Experience
        </a>
        <a
          href="#skills"
          class="px-3 py-1.5 text-sm font-medium text-slate-600 hover:text-accent transition-colors rounded-lg hover:bg-slate-100"
        >
          Skills
        </a>
        <a
          href="/cv"
          class="px-3 py-1.5 text-sm font-medium border border-slate-200 rounded-lg hover:border-accent hover:text-accent transition-all"
        >
          CV
        </a>
        <a
          href={`mailto:${profile.email}`}
          class="px-3 py-1.5 text-sm font-medium bg-accent text-white rounded-lg hover:bg-accent-dark transition-all shadow-soft"
        >
          Contact
        </a>
      </nav>
    </div>
  </header>

  <main class="bg-gradient-to-br from-slate-50 via-white to-indigo-50/30 min-h-screen">
    <div class="mx-auto max-w-7xl px-6 py-8">
      <!-- Hero Section - Compact -->
      <section class="mb-8">
        <div class="flex flex-col md:flex-row gap-8 items-center md:items-start">
          <div class="shrink-0">
            <div class="relative">
              <div class="absolute inset-0 bg-accent-gradient rounded-full blur-2xl opacity-20"></div>
              <img
                src={profile.avatarUrl}
                width="220"
                height="220"
                decoding="async"
                fetchpriority="high"
                alt={profile.name}
                class="relative w-44 h-44 md:w-56 md:h-56 rounded-full object-cover ring-4 ring-white shadow-xl"
              />
            </div>
          </div>
          
          <div class="flex-1 text-center md:text-left">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 text-accent text-sm font-medium mb-3">
              <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
              Available for opportunities
            </div>
            
            <h1 class="font-heading text-3xl md:text-4xl font-extrabold tracking-tight text-slate-900">
              Hi, I'm <span class="text-gradient">{profile.name.split(" ")[0]}</span>
            </h1>
            
            <p class="text-lg text-slate-600 mt-2 font-medium">
              {profile.role}
            </p>
            
            <p class="text-slate-600 mt-3 max-w-2xl leading-relaxed">
              {profile.summary}
            </p>
            
            <div class="mt-5 flex flex-wrap gap-3 justify-center md:justify-start">
              <a href="/cv" class="btn-primary inline-flex items-center gap-2 text-sm px-4 py-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                View CV
              </a>
              <a
                href={profile.linkedin}
                target="_blank"
                rel="noreferrer"
                class="p-2 border border-slate-200 rounded-lg hover:border-accent hover:text-accent transition-all"
                aria-label="LinkedIn"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
              <a
                href={profile.github}
                target="_blank"
                rel="noreferrer"
                class="p-2 border border-slate-200 rounded-lg hover:border-accent hover:text-accent transition-all"
                aria-label="GitHub"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              </a>
              <a
                href={`mailto:${profile.email}`}
                class="p-2 border border-slate-200 rounded-lg hover:border-accent hover:text-accent transition-all"
                aria-label="Email"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Two Column Layout: Experience + Skills -->
      <div class="grid lg:grid-cols-[1fr_380px] gap-8">
        <!-- Left Column: Work Experience -->
        <section id="experience">
          <h2 class="font-heading text-2xl font-bold text-slate-900 mb-4 flex items-center gap-2">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            Work Experience
          </h2>
          
          <div class="space-y-4">
            {featuredWork.map((w) => (
              <article class="card-modern p-5 group">
                <div class="flex items-start gap-4">
                  <div class="w-24 shrink-0">
                    <div class="text-xs font-semibold text-accent">{w.period}</div>
                    {w.period.includes("PRESENT") && (
                      <span class="inline-flex items-center gap-1 mt-1 px-1.5 py-0.5 rounded-full bg-green-100 text-green-700 text-[10px] font-medium">
                        <span class="w-1 h-1 bg-green-500 rounded-full animate-pulse"></span>
                        Current
                      </span>
                    )}
                  </div>
                  
                  <div class="flex-1 min-w-0">
                    <h3 class="text-base font-bold text-slate-900 group-hover:text-accent transition-colors">
                      {w.role}
                    </h3>
                    <p class="text-sm text-slate-600 font-medium">{w.company}</p>
                    
                    <div class="flex flex-wrap gap-1.5 mt-2">
                      {w.tech.split(", ").slice(0, 6).map((t) => (
                        <span class="px-2 py-0.5 text-[10px] font-medium rounded-full bg-slate-100 text-slate-600">{t}</span>
                      ))}
                      {w.tech.split(", ").length > 6 && (
                        <span class="px-2 py-0.5 text-[10px] font-medium rounded-full bg-slate-100 text-slate-500">+{w.tech.split(", ").length - 6}</span>
                      )}
                    </div>
                    
                    <ul class="mt-3 space-y-1.5">
                      {w.bullets.map((b) => (
                        <li class="flex items-start gap-2 text-sm text-slate-600">
                          <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                          </svg>
                          <span>{b}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </article>
            ))}
          </div>
          
          <div class="mt-4 text-center">
            <a href="/cv" class="text-sm text-accent hover:underline inline-flex items-center gap-1">
              View Full CV
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
          </div>
        </section>

        <!-- Right Column: Skills -->
        <aside id="skills" class="space-y-4">
          <!-- Technologies -->
          <div class="card-modern p-5">
            <div class="flex items-center gap-2 mb-4">
              <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                </svg>
              </div>
              <h3 class="font-bold text-slate-900">Technologies</h3>
            </div>
            <div class="flex flex-wrap gap-1.5">
              {techStack.map((t) => (
                <span class="tag-accent text-xs">{t}</span>
              ))}
            </div>
          </div>
          
          <!-- Soft Skills -->
          <div class="card-modern p-5">
            <div class="flex items-center gap-2 mb-4">
              <div class="w-8 h-8 rounded-lg bg-purple-500/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
              </div>
              <h3 class="font-bold text-slate-900">Soft Skills</h3>
            </div>
            <ul class="space-y-2">
              {softSkills.map((s) => (
                <li class="flex items-center gap-2 text-slate-600">
                  <svg class="w-4 h-4 text-purple-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span class="text-sm">{s}</span>
                </li>
              ))}
            </ul>
          </div>
          
          <!-- Languages -->
          <div class="card-modern p-5">
            <div class="flex items-center gap-2 mb-4">
              <div class="w-8 h-8 rounded-lg bg-emerald-500/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
                </svg>
              </div>
              <h3 class="font-bold text-slate-900">Languages</h3>
            </div>
            <ul class="space-y-2">
              {languages.map((l) => {
                const [lang, level] = l.split(" (");
                const cleanLevel = level?.replace(")", "") || "";
                return (
                  <li class="flex items-center justify-between">
                    <span class="font-medium text-slate-900 text-sm">{lang}</span>
                    <span class="text-xs text-slate-500">{cleanLevel}</span>
                  </li>
                );
              })}
            </ul>
          </div>

          <!-- Contact Card -->
          <div class="card-modern p-5">
            <div class="flex items-center gap-2 mb-4">
              <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center">
                <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <h3 class="font-bold text-slate-900">Contact</h3>
            </div>
            <div class="space-y-2 text-sm">
              <a href={`mailto:${profile.email}`} class="flex items-center gap-2 text-slate-600 hover:text-accent transition-colors">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                <span class="truncate">{profile.email}</span>
              </a>
              <a href={`tel:${profile.phone}`} class="flex items-center gap-2 text-slate-600 hover:text-accent transition-colors">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
                <span>{profile.phone}</span>
              </a>
              <div class="flex items-center gap-2 text-slate-600">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span>{profile.location}</span>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="py-6 border-t border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="text-sm text-slate-500">
        &copy; {new Date().getFullYear()} {profile.name}
      </div>
      <div class="flex items-center gap-4">
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noreferrer"
          class="text-slate-400 hover:text-accent transition-colors"
          aria-label="LinkedIn"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a
          href={profile.github}
          target="_blank"
          rel="noreferrer"
          class="text-slate-400 hover:text-accent transition-colors"
          aria-label="GitHub"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
        <a
          href={`mailto:${profile.email}`}
          class="text-slate-400 hover:text-accent transition-colors"
          aria-label="Email"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </a>
      </div>
    </div>
  </footer>
</BaseLayout>
