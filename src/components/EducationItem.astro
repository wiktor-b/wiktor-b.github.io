---
interface Props {
  school: string;
  degree: string;
  period: string;
}

const { school, degree, period } = Astro.props;
---

<article class="flex gap-3 print:gap-2 avoid-break">
  <div class="w-20 print:w-14 shrink-0">
    <div class="text-[11px] text-slate-500 font-medium leading-tight">{period}</div>
  </div>
  <div class="flex-1">
    <h3 class="font-bold text-slate-900 text-sm">{school}</h3>
    <div class="text-xs text-slate-600">{degree}</div>
  </div>
</article>
